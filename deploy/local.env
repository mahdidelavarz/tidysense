# Values for the local rehearsal only (docker-compose.local.yml). Nothing here is a real
# secret and none of it may be used on a server.
SITE_HOST=localhost
LOG_DRIVER=json-file
POSTGRES_PASSWORD=local-rehearsal-database-password
JWT_SIGNING_KEY=local-rehearsal-signing-key-at-least-32-chars
OTP_HASHING_KEY=local-rehearsal-hashing-key-at-least-32-chars
KAVENEGAR_API_KEY=not-used-in-development
KAVENEGAR_VERIFY_TEMPLATE=not-used-in-development
AI_PLANNING_PROVIDER=mock
AI_RECONCILE_PROVIDER=mock
OPERATOR_PHONE=+989120000001
ALERT_EMAIL_TO=operator@tidysense.test
ALERT_EMAIL_FROM=alerts@tidysense.test
SMTP_HOST=mail
SMTP_PORT=1025
SUPPORT_CONTACT=support@tidysense.test
BACKUP_RETENTION_DAYS=30
