# Copy to .env on the server (mode 600, never committed) and fill in. Values marked "required"
# stop "docker compose" or the backend from starting when they are missing.

# Public host name of the pilot, without scheme (required). Caddy obtains its certificate.
SITE_HOST=
# Only when TLS is terminated in front of this server: ":80".
# SITE_ADDRESS=

# Database password and the two application secrets (required). Each at least 32 random characters.
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
OTP_HASHING_KEY=

# Kavenegar SMS (required): the key and the sender line of the pilot account.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# AI providers: "mock" (the samples) or "deepseek". With deepseek the key is required and
# planning asks every user for consent before any text is sent.
AI_PLANNING_PROVIDER=mock
AI_RECONCILE_PROVIDER=mock
DEEPSEEK_API_KEY=

# The operator account (required) and one internal account, as +98 numbers. Their activity
# is reported apart from the pilot metrics.
OPERATOR_PHONE=
INTERNAL_PHONE=

# Daily alert digest (required): where it goes and the SMTP account that sends it.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The channel pilot participants use for support and to ask for erasure (required). It is
# shown in the privacy notice exactly as written here.
SUPPORT_CONTACT=

# Days a database dump is kept. The privacy notice promises erasure everywhere within 30 days;
# do not raise this without changing Pilot:ErasureCompletionDays and the notice.
BACKUP_RETENTION_DAYS=30
